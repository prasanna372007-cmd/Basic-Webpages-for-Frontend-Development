body {
    font-family: Arial, sans-serif;
    text-align: center;
    margin: 20px;
    background-color: #f5f5f5;
}

button {
    padding: 10px 20px;
    cursor: pointer;
    margin: 20px;
    background-color: green;
    color: white;
    border: none;
    border-radius: 5px;
}

#output {
    margin-top: 20px;
}

.card {
    background-color: white;
    border: 1px solid #ccc;
    margin: 10px auto;
    padding: 15px;
    width: 60%;
    border-radius: 8px;
    box-shadow: 2px 2px 10px rgba(0,0,0,0.1);
    text-align: left;
}